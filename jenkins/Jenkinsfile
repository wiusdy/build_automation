pipeline {
    agent any

    parameters {
        string(name: 'IMAGE_TAG', defaultValue: 'latest', description: 'Docker image tag generated by CI')
    }

    environment {
        AWS_ENDPOINT = "http://localhost:4566"
        AWS_DEFAULT_REGION = "us-east-1"
        REPO_NAME = "ci-cd-demo"
        GITHUB_TOKEN = credentials('github-token')
    }

    stages {

        stage('Download Docker Artifact from GitHub') {
            steps {
                sh '''
                echo "Downloading artifact from GitHub Actions..."

                # Get artifact URL for the workflow run
                ARTIFACT_URL=$(curl -s -H "Authorization: token ${GITHUB_TOKEN}" \
                    -L "https://api.github.com/repos/<SEU_USUARIO>/<SEU_REPO>/actions/artifacts" \
                    | jq -r '.artifacts[0].archive_download_url')

                # Download and unzip
                curl -L -H "Authorization: token ${GITHUB_TOKEN}" "$ARTIFACT_URL" --output docker-image.zip
                unzip -o docker-image.zip
                '''
            }
        }

        stage('Load Docker Image') {
            steps {
                sh '''
                echo "Loading docker image..."
                docker load < ci-cd-demo.tar
                '''
            }
        }

        stage('Login to LocalStack ECR') {
            steps {
                sh '''
                echo "Logging into LocalStack ECR..."
                aws ecr get-login-password --endpoint-url=${AWS_ENDPOINT} \
                    | docker login --username AWS --password-stdin localhost:4566
                '''
            }
        }

        stage('Tag & Push to LocalStack ECR') {
            steps {
                sh '''
                echo "Pushing image to LocalStack ECR..."
                docker tag ci-cd-demo:latest localhost:4566/${REPO_NAME}:${IMAGE_TAG}
                docker push localhost:4566/${REPO_NAME}:${IMAGE_TAG}
                '''
            }
        }

        stage('Deploy Mock ECS Service') {
            steps {
                sh '''
                echo "[MOCK] Simulating ECS deployment..."
                echo "[MOCK] Updating service ci-cd-demo-service with image tag: ${IMAGE_TAG}..."
                echo "[MOCK] Deployment completed!"
                '''
            }
        }
    }

    post {
        success {
            echo "CD Pipeline completed successfully (mocked ECS)."
        }
        failure {
            echo "CD Pipeline failed."
        }
    }
}
