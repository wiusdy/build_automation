pipeline {
    agent any

    environment {
        AWS_ENDPOINT = "http://localhost:4566"
        AWS_DEFAULT_REGION = "us-east-1"
        REPO_NAME = "ci-cd-demo"
        GITHUB_TOKEN = credentials('github-token')
    }

    stages {

        stage('Download Docker Artifact from GitHub') {
            steps {
                sh '''
                echo "Downloading artifacts from GitHub Actions..."

                # Get the latest artifact download URL
                ARTIFACT_URL=$(curl -s -H "Authorization: token ${GITHUB_TOKEN}" \
                    https://api.github.com/repos/<YOUR_USER>/<YOUR_REPO>/actions/artifacts \
                    | jq -r '.artifacts[] | select(.name=="docker-artifacts") | .archive_download_url' | head -n 1)

                if [ -z "$ARTIFACT_URL" ]; then
                    echo "ERROR: No artifact found!"
                    exit 1
                fi

                echo "Artifact URL: $ARTIFACT_URL"

                # Download zip
                curl -L -H "Authorization: token ${GITHUB_TOKEN}" \
                    "$ARTIFACT_URL" --output artifacts.zip

                # Extract files
                unzip -o artifacts.zip
                '''
            }
        }

        stage('Read Image Tag') {
            steps {
                script {
                    IMAGE_TAG = sh(script: "cat image_tag.txt", returnStdout: true).trim()
                    echo "Deploying IMAGE_TAG=${IMAGE_TAG}"
                }
            }
        }

        stage('Load Docker Image') {
            steps {
                sh '''
                echo "Loading Docker image..."
                docker load < ci-cd-demo.tar
                '''
            }
        }

        stage('Login to LocalStack ECR') {
            steps {
                sh '''
                echo "Logging into LocalStack ECR..."
                aws ecr get-login-password --endpoint-url=${AWS_ENDPOINT} \
                    | docker login --username AWS --password-stdin localhost:4566
                '''
            }
        }

        stage('Tag & Push to LocalStack ECR') {
            steps {
                sh '''
                echo "Tagging and pushing Docker image to LocalStack ECR..."

                docker tag ci-cd-demo:${IMAGE_TAG} localhost:4566/${REPO_NAME}:${IMAGE_TAG}
                docker push localhost:4566/${REPO_NAME}:${IMAGE_TAG}
                '''
            }
        }

        stage('Mock ECS Deployment') {
            steps {
                sh '''
                echo "[MOCK] Simulating ECS deploy..."
                echo "[MOCK] Updating service ci-cd-demo-service with image: ${IMAGE_TAG}"
                echo "[MOCK] Deployment completed!"
                '''
            }
        }
    }

    post {
        success { echo "CD pipeline completed successfully!" }
        failure { echo "CD pipeline failed!" }
    }
}
